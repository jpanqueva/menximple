# --- Servidor MCP ---
MCP_HOST=0.0.0.0
MCP_PORT=8000
# URL base que usan los clientes (TUI y modo chat). Configurable para despliegue.
MEMORY_BASE_URL=http://localhost:8000/mcp

# --- Qdrant (único almacén) ---
# En docker-compose el host es el servicio 'qdrant'.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Embeddings del resumen (OPCIONAL, off por defecto) ---
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMS=384

# --- Autenticación ---
# Protege crear/listar cuentas. Vacío = abierto (solo dev).
ADMIN_TOKEN=
# apikey por defecto para pruebas/stdio sin headers HTTP. Vacío en producción.
DEV_APIKEY=
